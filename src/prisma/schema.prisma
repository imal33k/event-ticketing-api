generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  STAFF
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
  REFUNDING
  REFUNDED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(USER)
  orders       Order[]
  createdAt    DateTime @default(now())
}

model Event {
  id                      String       @id @default(uuid())
  title                   String
  description             String?
  venue                   String
  startsAt                DateTime
  endsAt                  DateTime
  publicRegistrationToken String       @unique @default(uuid())
  ticketTypes             TicketType[]
  createdAt               DateTime     @default(now())

  @@index([publicRegistrationToken])
  @@index([startsAt, endsAt])
  @@map("events")
}

model TicketType {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String // e.g. "VIP", "General"
  priceKobo Int // store money as integer minor units
  capacity  Int
  sold      Int      @default(0)
  tickets   Ticket[]

  @@index([eventId])
}

model Order {
  id               String      @id @default(uuid())
  userId           String?
  user             User?       @relation(fields: [userId], references: [id])
  guestName        String?
  guestEmail       String?
  emailSentAt      DateTime?
  status           OrderStatus @default(PENDING)
  total            Int
  expiresAt        DateTime    @default(now())
  paymentReference String?     @unique
  paidAt           DateTime?
  tickets          Ticket[]
  createdAt        DateTime    @default(now())
  refundedAt       DateTime?

  @@index([userId])
  @@index([status, expiresAt])
}

model Ticket {
  id           String     @id @default(uuid())
  code         String     @unique @default(uuid()) // QR/check-in code
  orderId      String
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])
  checkedInAt  DateTime?
  CheckInBy    String?

  @@index([orderId])
  @@index([ticketTypeId])
}
